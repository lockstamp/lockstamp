      "schema": "public",
      "name": "get_all_emails",
      "args": "",
      "definition": "CREATE OR REPLACE FUNCTION public.get_all_emails()\n RETURNS TABLE(email text)\n LANGUAGE sql\n SECURITY DEFINER\nAS $function$\n  select email from auth.users;\n$function$\n",
      "anon_execute": true,
      "authenticated_execute": true
    },
    {
      "schema": "public",
      "name": "handle_new_user",
      "args": "",
      "definition": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  insert into public.profiles (id, full_name)\n  values (new.id, new.raw_user_meta_data ->> 'full_name');\n  return new;\nend;\n$function$\n",
      "anon_execute": true,
      "authenticated_execute": true
    }
